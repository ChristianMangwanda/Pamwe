# Secrets for local `supabase functions serve`. Copy to supabase/functions/.env
# (gitignored) and fill in real values. On hosted, set these BY HAND in the
# Supabase dashboard (the CLI is logged into the wrong account and cannot reach
# the active project — see CLAUDE.md's hosted-identity block).

# OpenAI API key for ask-pamwe's `build` mode (the Plans search — the primary
# path). Without it, build returns 503 "Ask Pamwe isn't configured yet."
OPENAI_API_KEY=sk-...

# Optional: override the build model (default gpt-5.6-luna, the family that
# tagged the Bible catalogue).
# OPENAI_MODEL=gpt-5.6-luna

# Anthropic API key for ask-pamwe's `plans` and `help` modes.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model (default claude-haiku-4-5). Must support structured
# outputs (Haiku 4.5, Sonnet 5, Opus 4.8, Fable 5).
# ANTHROPIC_MODEL=claude-haiku-4-5

# Shared secret proving a notify-* call came from a database trigger and not from
# a stranger with the function URL. The six webhook targets run with
# verify_jwt = false, so this is the only thing standing between the internet and
# a push on someone's phone: they refuse every request without it, and refuse to
# start without the variable set.
#
# The SAME value must exist on the database side, or no notification is sent at
# all. Locally that means the app.settings.notify_webhook_secret GUC; on hosted it
# is the Vault secret notify_webhook_secret (see
# 20260808000005_notify_webhook_secret.sql). Generate with: openssl rand -hex 32
NOTIFY_WEBHOOK_SECRET=
